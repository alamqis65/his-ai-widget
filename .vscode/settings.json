{
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "always"
  },
  "cSpell.language": "en,id-id",
  "cSpell.words": [
    "AMBROXOL",
    "anamesa",
    "beneran",
    "dicek",
    "Dijeda",
    "dikonfigurasi",
    "eclaim",
    "eligibilitas",
    "Glimepiride",
    "hiperemis",
    "HISAI",
    "HISAISDK",
    "medin",
    "Melitus",
    "normalised",
    "nyangkut",
    "poli",
    "ronki",
    "simptomatik",
    "soapi",
    "TIMESLICE",
    "vesikuler",
    "VITALSIGN"
  ],
  "python-envs.defaultEnvManager": "ms-python.python:system",
  "typescript.suppressDeprecationWarnings": true,
  "[csharp]": {
    "editor.defaultFormatter": "csharpier.csharpier-vscode"
  }
}
